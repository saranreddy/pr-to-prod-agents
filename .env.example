# Core Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration
# Choose: anthropic, bedrock, or mock
LLM_PROVIDER=mock

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxx

# AWS Bedrock Configuration (if using bedrock provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Model Selection per Agent
PLANNER_MODEL=claude-3-5-haiku-20241022
CODER_MODEL=claude-3-5-sonnet-20241022
REVIEWER_MODEL=claude-3-5-sonnet-20241022
TESTER_MODEL=claude-3-5-sonnet-20241022
DEPLOYER_MODEL=claude-3-5-haiku-20241022
REPORTER_MODEL=claude-3-5-haiku-20241022

# Cost and Rate Limits
MAX_TOKENS_PER_JOB=500000
MAX_RETRIES_CODER=3
MAX_RETRIES_REVIEWER=3

# GitHub Configuration
GITHUB_TOKEN=ghp_xxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Separate per-agent tokens (production)
# PLANNER_GITHUB_TOKEN=ghp_readonly_xxxxx
# CODER_GITHUB_TOKEN=ghp_push_agent_xxxxx
# REVIEWER_GITHUB_TOKEN=ghp_comment_xxxxx
# TESTER_GITHUB_TOKEN=ghp_push_read_ci_xxxxx
# DEPLOYER_GITHUB_TOKEN=ghp_merge_deploy_xxxxx
# REPORTER_GITHUB_TOKEN=ghp_comment_xxxxx

# Repository Configuration (for demo/testing)
TARGET_REPO_OWNER=your-org
TARGET_REPO_NAME=sample-app
DEFAULT_BASE_BRANCH=main

# Checkpoint Storage
# Database URL: sqlite:///checkpoints.db or postgresql://user:pass@host/db
DATABASE_URL=sqlite:///checkpoints.db

# Notification Configuration
NOTIFIER_TYPE=console  # console, slack, sns
SLACK_WEBHOOK_URL=
SNS_TOPIC_ARN=

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Webhook Server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Sandbox Configuration
SANDBOX_TYPE=docker  # docker or fargate
DOCKER_IMAGE=python:3.11-slim

# Health Check Configuration (for deployer)
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_DURATION_MINUTES=5
ERROR_RATE_THRESHOLD_PERCENT=5.0

# Evaluation
EVAL_OUTPUT_DIR=eval_results
